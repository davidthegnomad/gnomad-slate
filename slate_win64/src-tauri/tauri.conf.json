{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gnomad Slate",
  "mainBinaryName": "gnomad-slate",
  "version": "1.0.0-alpha.1",
  "identifier": "com.gnomadstudio.gnomad-slate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gnomad Slate",
        "width": 1120,
        "height": 640,
        "minWidth": 960,
        "minHeight": 520,
        "theme": "Dark",
        "backgroundColor": "#0d0d10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://github.com https://*.githubusercontent.com https://api.github.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBQTkyNUU2QzQyQjdEQwpSV1RjdDBKc1hwS3FBYlNCU1RjaXR6N2thWVhiYTRMUHFQZnM3b25FcTM2eklPQnVZQUNiODd3Swo=",
      "endpoints": [
        "https://github.com/davidthegnomad/gnomad-slate/releases/latest/download/latest.json"
      ]
    }
  }
}
