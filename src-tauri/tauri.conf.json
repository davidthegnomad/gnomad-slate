{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gnomad Slate",
  "mainBinaryName": "gnomad-slate",
  "version": "2.1.0-beta.8",
  "identifier": "com.gnomadstudio.gnomad-slate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gnomad Slate",
        "width": 1120,
        "height": 640,
        "minWidth": 960,
        "minHeight": 520,
        "theme": "Dark",
        "backgroundColor": "#0d0d10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://github.com https://*.githubusercontent.com https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libsoup-3.0-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ],
        "desktopTemplate": "bundle/linux/gnomad-slate.desktop.hbs"
      },
      "rpm": {
        "release": "1",
        "depends": [
          "webkit2gtk4.1",
          "libsoup3",
          "gtk3",
          "libappindicator-gtk3"
        ],
        "desktopTemplate": "bundle/linux/gnomad-slate.desktop.hbs"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFMERGMTY2MUMzMjJCMTgKUldRWUt6SWNadkVOSGdENGZRaGRRVWs4YVd4YnQ2UjBtYXhhZEx2bEszYzdUbmRHUHZCU2E0SEYK",
      "endpoints": [
        "https://github.com/davidthegnomad/gnomad-slate/releases/latest/download/latest.json"
      ]
    }
  }
}
